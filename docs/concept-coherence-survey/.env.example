DATA_ROOT=/data/quantization/zaima/videosal_datasets/dhf1k/visual_gallery/concepts_v5
ANNOTATION_ROOT=/data/quantization/zaima/videosal_datasets/dhf1k/visual_gallery/concepts_v5/annotations
ALLOWED_EMAILS=annotator1@example.edu,annotator2@example.edu,annotator3@example.edu
# Empty = include every group_* folder. Otherwise list folder suffixes, e.g. 0,1,2,3.
GROUP_IDS=
# Origin only (no repo path), e.g. https://yourname.github.io
ALLOWED_ORIGINS=https://YOURNAME.github.io
# true = optional boxed full-frame viewer, with use logged; false = patches only.
ALLOW_FRAME_CONTEXT=true

# smtp = real participants (requires ALLOWED_EMAILS + SMTP_*).
# console = local testing; codes print in the server terminal (requires ALLOWED_EMAILS).
# preview = no email/SMTP; anonymous browser sessions under ANNOTATION_ROOT/preview/.
AUTH_MODE=smtp
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=study@example.edu
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM=study@example.edu

# Preview-mode example (no ALLOWED_EMAILS / SMTP required):
# AUTH_MODE=preview
# ALLOWED_ORIGINS=https://zaima14zarnaz.github.io
# Then:
#   python -m uvicorn backend.app:create_app --factory --host 127.0.0.2 --port 8000
